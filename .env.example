# ==========================================
# NearHire Root Environment Template
# ==========================================

# Application Port & Environment
PORT=5000
NODE_ENV=production
CLIENT_URL=http://localhost:80

# MongoDB (Local or Atlas)
MONGO_URI=mongodb://mongodb:27017/nearhire

# Redis Host & Port
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets (Use high-entropy random strings)
JWT_SECRET=your_super_secret_jwt_key_here_32_chars_min
JWT_REFRESH_SECRET=your_super_refresh_jwt_key_here_32_chars_min
JWT_EXPIRES_IN=7d

# AI API Providers (Gemini / OpenAI)
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key

# Email Alerts (SMTP)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=noreply@nearhire.com

# AWS Deployment Credentials (Optional for local, used by CI/CD)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=nearhire-frontend-assets
AWS_CLOUDFRONT_DISTRIBUTION_ID=
AWS_ECR_REGISTRY=
