PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB
MONGO_URI=mongodb://localhost:27017/nearhire

# Redis (BullMQ and Caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets
JWT_SECRET=super_secret_jwt_key_nearhire_prod_32_chars
JWT_REFRESH_SECRET=super_refresh_jwt_key_nearhire_prod_32_chars
JWT_EXPIRES_IN=7d

# AI Matching (Gemini / OpenAI)
GEMINI_API_KEY=your_gemini_api_key_here
AI_PROVIDER=gemini

# Email Notifications (SMTP)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=noreply@nearhire.com

# AWS Configuration (Optional for local, required for S3/CloudFront)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=nearhire-job-assets
